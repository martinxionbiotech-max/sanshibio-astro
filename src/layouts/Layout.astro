---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, any>[];
  ogImage?: string;
}

const { title, description, jsonLd = [], ogImage = '/images/banner-home.png' } = Astro.props;

const lang = Astro.currentLocale ?? 'zh';
const isEn = lang === 'en';

const siteName = isEn ? 'Hebei Sanshi Biotechnology Co., Ltd.' : '河北三狮生物科技有限公司';
const canonical = new URL(Astro.url.pathname, Astro.site);

const pathname = Astro.url.pathname;
const zhPath = pathname.replace(/^\/en/, '') || '/';
const enPath = pathname.startsWith('/en') ? pathname : (pathname === '/' ? '/en/' : `/en${pathname}`);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${Astro.site}#organization`,
  name: siteName,
  alternateName: ['三狮生物', 'Sanshi Bio', 'Three Lions Bio'],
  url: Astro.site?.toString(),
  logo: `${Astro.site}images/logo.png`,
  foundingDate: '2018',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '石家庄高新区太行南大街509号国械堂高端医疗器械产业园A-5栋702室',
    addressLocality: '石家庄市',
    addressRegion: '河北省',
    postalCode: '050000',
    addressCountry: 'CN',
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: '+86-156-1237-2623',
      contactType: 'customer service',
      email: 'martin@senobiocorp.com',
    },
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${Astro.site}#website`,
  url: Astro.site?.toString(),
  name: siteName,
  description: isEn
    ? 'Racing pigeon gene testing, pathogen detection and pedigree verification.'
    : '赛鸽飞行能力基因检测、病原检测与血统鉴定服务。',
  publisher: { '@id': `${Astro.site}#organization` },
  inLanguage: isEn ? 'en' : 'zh-CN',
};

const webpageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical.toString()}#webpage`,
  url: canonical.toString(),
  name: title,
  description: description || '',
  isPartOf: { '@id': `${Astro.site}#website` },
  about: { '@id': `${Astro.site}#organization` },
  inLanguage: isEn ? 'en' : 'zh-CN',
};
---

<!doctype html>
<html lang={isEn ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="baidu-site-verification" content="codeva-zdApuwYuPY" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(zhPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(zhPath, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webpageSchema)} />
    {
      jsonLd.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    }
  </head>
  <body class="min-h-screen bg-white text-slate-700 antialiased">
    <Header />

    <main><slot /></main>

    <Footer />
  </body>
</html>
