---
import Layout from '../layouts/Layout.astro';

const title = '关于三狮｜河北三狮生物科技有限公司';
const description =
  '河北三狮生物科技有限公司坐落于石家庄国际生物医药产业园，由国家重大人才工程入选者发起创立，专注动植物基因检测与AI基因育种，形成检测设备与试剂制造、智能数据模型开发、实验室建设与技术培训三位一体产业布局。';

const facts = [
  ['企业名称', '河北三狮生物科技有限公司'],
  ['成立时间', '2018 年 9 月'],
  ['企业性质', '高新技术企业（国家重大人才工程入选者发起创立）'],
  ['注册资本', '300 万元人民币'],
  ['质量认证', 'ISO9001 质量体系认证'],
  ['产品规模', '300 余种产品'],
  ['知识产权', '22 项专利 · 4 项注册商标 · 2 项软件著作权'],
  ['所在地', '石家庄高新区太行南大街509号国械堂高端医疗器械产业园A-5栋702室'],
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://sanshibio.com/' },
    { '@type': 'ListItem', position: 2, name: '关于三狮' },
  ],
};
---

<Layout title={title} description={description} jsonLd={[breadcrumbLd]}>
  <section class="bg-gradient-to-br from-brand-700 to-deep-600 text-white">
    <div class="container-site py-16 sm:py-20">
      <nav class="mb-4 text-sm text-brand-200">
        <a href="/" class="hover:text-white">首页</a> <span class="mx-1">/</span> 关于三狮
      </nav>
      <h1 class="text-3xl font-bold sm:text-4xl">关于三狮</h1>
      <p class="mt-4 max-w-2xl text-lg text-brand-50">以基因检测技术为核心的动植物分子诊断与 AI 基因育种企业</p>
    </div>
  </section>

  <section class="container-site py-16">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div class="prose-sanshi">
        <h2 class="text-2xl font-bold">公司简介</h2>
        <p>
          河北三狮生物科技有限公司坐落于河北「石家庄国际生物医药产业园」，由「国家重大人才工程入选者」发起创立的高新技术企业。
          三狮生物专注<b>动植物基因检测技术</b>和<b>AI 基因育种技术</b>开发与应用，
          致力于为用户提供智能化、标准化的基因检测和生物育种整体解决方案。
        </p>
        <p>
          公司形成了<b>检测设备与检测试剂开发制造、智能数据模型开发、实验室建设与技术培训</b>三位一体的产业布局，
          建立了完善的产品生产工艺与质量管理体系，并取得了 ISO9001 质量体系认证。
        </p>
        <p>
          公司目前推出产品 300 多种，涵盖食品安全检测、动植物检测、基因育种、生物智造等多个领域，
          核心产品包括热启动 Taq 酶、分子诊断试剂原材料、实时荧光定量 PCR 仪、全自动核酸提取仪及各类基因检测试剂盒。
        </p>
      </div>
      <div>
        <img src="/images/company-intro.png" alt="三狮生物公司简介" class="w-full rounded-2xl border border-slate-200 shadow-sm" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- 三位一体 -->
  <section class="bg-slate-50 py-16">
    <div class="container-site">
      <div class="text-center">
        <span class="badge">产业布局</span>
        <h2 class="section-title mt-3">三位一体产业布局</h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="card text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-3xl">🧪</div>
          <h3 class="mt-4 font-semibold text-slate-900">检测设备与试剂制造</h3>
          <p class="mt-2 text-sm text-slate-600">荧光定量 PCR 仪、核酸提取仪及分子诊断试剂研发与生产。</p>
        </div>
        <div class="card text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-3xl">🤖</div>
          <h3 class="mt-4 font-semibold text-slate-900">智能数据模型开发</h3>
          <p class="mt-2 text-sm text-slate-600">AI 基因育种与生物信息学分析模型开发。</p>
        </div>
        <div class="card text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-3xl">🏗️</div>
          <h3 class="mt-4 font-semibold text-slate-900">实验室建设与技术培训</h3>
          <p class="mt-2 text-sm text-slate-600">实验室整体建设方案与 PCR 检测技术培训。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 荣誉资质 -->
  <section class="container-site py-16">
    <div class="grid items-start gap-12 lg:grid-cols-2">
      <div>
        <span class="badge">荣誉资质</span>
        <h2 class="section-title mt-3">资质与知识产权</h2>
        <p class="mt-4 leading-relaxed text-slate-600">
          公司建立了标准化的核酸检测产品生产工艺与质量控制体系，拥有多项知识产权，
          表明企业具备较强的实力和创新能力。
        </p>
        <div class="mt-6 grid grid-cols-3 gap-4 text-center">
          <div class="card">
            <div class="text-2xl font-bold text-brand-600">22</div>
            <div class="mt-1 text-sm text-slate-500">专利信息</div>
          </div>
          <div class="card">
            <div class="text-2xl font-bold text-brand-600">4</div>
            <div class="mt-1 text-sm text-slate-500">注册商标</div>
          </div>
          <div class="card">
            <div class="text-2xl font-bold text-brand-600">2</div>
            <div class="mt-1 text-sm text-slate-500">软件著作权</div>
          </div>
        </div>
      </div>
      <div>
        <img src="/images/honor.jpg" alt="三狮生物荣誉资质" class="mx-auto max-h-[480px] w-auto rounded-2xl border border-slate-200 shadow-sm" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- 企业信息 -->
  <section class="bg-slate-50 py-16">
    <div class="container-site max-w-3xl">
      <h2 class="section-title text-center">企业信息</h2>
      <div class="mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="table-base">
          <tbody>
            {facts.map(([k, v]) => (
              <tr>
                <td class="w-36 font-semibold text-slate-700">{k}</td>
                <td class="text-slate-600">{v}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Layout>
