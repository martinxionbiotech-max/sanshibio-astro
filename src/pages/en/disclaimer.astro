---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';

const title = 'Disclaimer | Sanshi Bio';
const description = 'Website disclaimer for Hebei Sanshi Biotechnology: interpretation of test reports, veterinary advice, content accuracy and external links.';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://sanshibio.net/en/' },
    { '@type': 'ListItem', position: 2, name: 'Disclaimer' },
  ],
};
---

<Layout title={title} description={description} jsonLd={[breadcrumbLd]}>
  <PageBanner title="Disclaimer" description="Please read the following before using this website or our testing services" breadcrumb="Disclaimer" />

  <section class="container-site py-16">
    <div class="prose-sanshi mx-auto max-w-3xl">
      <h2 class="text-xl font-bold">1. Interpretation of Test Results</h2>
      <p>
        Genetic test reports provided by this website and by Sanshi Bio describe the genetic information of the
        sample under current technical conditions. They reveal <b>genetic potential</b> and the
        <b>presence of pathogens</b> — they <b>cannot on their own serve as the sole basis for a disease diagnosis
        or a prediction of race performance</b>. A pigeon's final performance also depends on management, training,
        nutrition and environmental conditions.
      </p>

      <h2 class="mt-8 text-xl font-bold">2. No Veterinary Advice</h2>
      <p>
        Content on this website about disease prevention and control is for general reference only and
        <b>does not constitute veterinary advice</b>. If a bird shows symptoms of illness, consult a licensed
        veterinarian for diagnosis and treatment; do not medicate based on this website alone.
      </p>

      <h2 class="mt-8 text-xl font-bold">3. Accuracy of Content</h2>
      <p>
        Sanshi Bio makes every effort to keep the information on this website accurate and current, but technology,
        product specifications and services may change. We do not warrant that all information is at all times
        complete, accurate or up to date. Product specifications are governed by the delivered goods.
      </p>

      <h2 class="mt-8 text-xl font-bold">4. External Links</h2>
      <p>
        This website may contain links to third-party websites for your convenience. Sanshi Bio is not responsible
        for the content or privacy practices of those third-party sites.
      </p>

      <h2 class="mt-8 text-xl font-bold">5. Intellectual Property</h2>
      <p>
        Copyright and related rights in the content of this website (text, images, marks and other materials)
        belong to Hebei Sanshi Biotechnology Co., Ltd. Reproduction, excerpting or commercial use without written
        permission is not permitted.
      </p>
    </div>
  </section>
</Layout>
