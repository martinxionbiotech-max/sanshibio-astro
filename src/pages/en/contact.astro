---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';

const title = 'Contact Us | Sanshi Bio';
const description =
  'Contact Hebei Sanshi Biotechnology: Tel/WeChat +86 15612372623, email martin@senobiocorp.com, WhatsApp +86 13323237275, address Shijiazhuang Hi-tech Zone, Hebei, China.';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://sanshibio.net/en/' },
    { '@type': 'ListItem', position: 2, name: 'Contact Us' },
  ],
};
---

<Layout title={title} description={description} jsonLd={[breadcrumbLd]}>
  <PageBanner title="Contact Us" description="Equipment, reagents, testing services and training — we welcome your inquiry and cooperation." breadcrumb="Contact Us" />

  <section class="container-site py-16">
    <div class="grid gap-8 lg:grid-cols-2">
      <div class="card">
        <h2 class="text-xl font-semibold text-slate-900">Contact Information</h2>
        <dl class="mt-6 space-y-5 text-sm">
          <div class="flex gap-4">
            <dt class="w-24 shrink-0 font-semibold text-slate-700">Tel / WeChat</dt>
            <dd><a href="tel:+8615612372623" class="text-brand-700 hover:underline">+86 156-1237-2623</a></dd>
          </div>
          <div class="flex gap-4">
            <dt class="w-24 shrink-0 font-semibold text-slate-700">WhatsApp</dt>
            <dd><a href="https://wa.me/8613323237275" target="_blank" rel="noopener" class="text-brand-700 hover:underline">+86 133-2323-7275</a></dd>
          </div>
          <div class="flex gap-4">
            <dt class="w-24 shrink-0 font-semibold text-slate-700">Email</dt>
            <dd><a href="mailto:martin@senobiocorp.com" class="text-brand-700 hover:underline">martin@senobiocorp.com</a></dd>
          </div>
          <div class="flex gap-4">
            <dt class="w-24 shrink-0 font-semibold text-slate-700">Website</dt>
            <dd>www.sanshibio.net</dd>
          </div>
          <div class="flex gap-4">
            <dt class="w-24 shrink-0 font-semibold text-slate-700">Address</dt>
            <dd class="leading-relaxed">Room 702, Building A-5, Guoxietang High-end Medical Device Industrial Park, No.509 Taihang South Street, Shijiazhuang Hi-tech Zone, Hebei, China</dd>
          </div>
        </dl>
      </div>

      <div class="card">
        <h2 class="text-xl font-semibold text-slate-900">Consult a Service</h2>
        <p class="mt-3 text-sm text-slate-600">
          Tell us your needs (flight-ability gene test / virus detection / product purchase / training) and we will get back to you promptly.
        </p>
        <div class="mt-6 rounded-xl bg-brand-50 p-5 text-sm text-brand-800">
          <p class="font-semibold">Services</p>
          <ul class="mt-2 space-y-1">
            <li>• Flight ability gene testing (8 genes)</li>
            <li>• Virus & pathogen detection (10 pathogens)</li>
            <li>• Gene ID / AB pigeon / paternity / sexing</li>
            <li>• Equipment & reagent purchase, training</li>
          </ul>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="tel:+8615612372623" class="btn-primary">Call Now</a>
          <a href="https://wa.me/8613323237275" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-[#25D366] px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-[#1eb857]">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
          <a href="mailto:martin@senobiocorp.com" class="btn-outline">Email Us</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
