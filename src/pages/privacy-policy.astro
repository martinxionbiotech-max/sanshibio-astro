---
import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';

const title = '隐私政策 - 三狮生物';
const description = '河北三狮生物科技有限公司隐私政策：说明我们在提供检测服务过程中如何收集、使用与保护您的个人信息与样本数据。';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://sanshibio.net/' },
    { '@type': 'ListItem', position: 2, name: '隐私政策' },
  ],
};
---

<Layout title={title} description={description} jsonLd={[breadcrumbLd]}>
  <PageBanner title="隐私政策" description="我们重视并保护您的个人信息与样本数据" breadcrumb="隐私政策" />

  <section class="container-site py-16">
    <div class="prose-sanshi mx-auto max-w-3xl">
      <h2 class="text-xl font-bold">一、信息收集</h2>
      <p>
        在您咨询或委托检测服务时，我们可能收集：您的姓名、联系方式（电话/邮箱）、寄送地址，
        以及检测所需的样本信息（如鸽子编号、足环号等）。我们仅收集为完成服务所必需的信息。
      </p>

      <h2 class="mt-8 text-xl font-bold">二、信息使用</h2>
      <p>
        我们收集的信息仅用于：<b>完成您委托的检测服务</b>、出具检测报告、联系沟通检测事宜。
        未经您的同意，我们不会将您的个人信息用于与服务无关的用途。
      </p>

      <h2 class="mt-8 text-xl font-bold">三、样本与数据保护</h2>
      <p>
        您的检测样本与基因数据将受到严格保护。检测报告仅提供给委托人本人，
        我们不会向任何无关第三方披露您的检测结果或个人信息，法律法规另有规定的除外。
      </p>

      <h2 class="mt-8 text-xl font-bold">四、信息安全</h2>
      <p>
        三狮生物采取合理的技术与管理措施保护您的个人信息安全，防止信息被未经授权的访问、使用、泄露或篡改。
      </p>

      <h2 class="mt-8 text-xl font-bold">五、您的权利</h2>
      <p>
        您有权查询、更正您的个人信息，或要求删除（法律法规规定需保留的除外）。
        如需行使上述权利，请通过本网站公示的联系方式与我们联系。
      </p>

      <h2 class="mt-8 text-xl font-bold">六、政策更新</h2>
      <p>
        本隐私政策可能适时更新，更新后的政策将在本页面公布。请定期查阅以了解最新内容。
      </p>
    </div>
  </section>
</Layout>
