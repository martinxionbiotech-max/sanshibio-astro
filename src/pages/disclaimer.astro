---
import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';

const title = '免责声明 - 三狮生物';
const description = '河北三狮生物科技有限公司网站免责声明：检测报告的解读、医疗建议、内容准确性与外部链接的免责说明。';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://sanshibio.com/' },
    { '@type': 'ListItem', position: 2, name: '免责声明' },
  ],
};
---

<Layout title={title} description={description} jsonLd={[breadcrumbLd]}>
  <PageBanner title="免责声明" description="请在使用本网站信息与检测服务前仔细阅读以下声明" breadcrumb="免责声明" />

  <section class="container-site py-16">
    <div class="prose-sanshi mx-auto max-w-3xl">
      <h2 class="text-xl font-bold">一、检测结果的解读</h2>
      <p>
        本网站及三狮生物提供的基因检测报告，反映的是检测样本在当前技术条件下的基因信息。
        基因检测结果揭示的是「遗传潜力」与「病原体存在情况」，<b>不能单独作为疾病诊断或赛绩预判的唯一依据</b>。
        赛鸽的最终表现还受饲养管理、训练水平、营养状况、天气环境等多种因素影响。
      </p>

      <h2 class="mt-8 text-xl font-bold">二、医疗建议免责</h2>
      <p>
        本网站关于赛鸽疫病防控的内容仅为科普参考，<b>不构成兽医诊疗建议</b>。
        当赛鸽出现疾病症状时，请及时咨询执业兽医，在专业指导下进行诊断与治疗，切勿仅依据本网站信息自行用药。
      </p>

      <h2 class="mt-8 text-xl font-bold">三、内容准确性</h2>
      <p>
        三狮生物尽力确保本网站信息的准确与及时更新，但技术、产品规格与服务内容可能调整，
        不保证所有信息在任何时候均完全准确、完整或最新。产品规格以实际交付为准。
      </p>

      <h2 class="mt-8 text-xl font-bold">四、外部链接</h2>
      <p>
        本网站可能包含指向第三方网站的链接，仅为方便用户，三狮生物对第三方网站的内容、隐私政策不承担责任。
      </p>

      <h2 class="mt-8 text-xl font-bold">五、知识产权</h2>
      <p>
        本网站内容（含文字、图片、标识等）的著作权及相关权利归河北三狮生物科技有限公司所有，
        未经书面许可，不得转载、摘编或用于商业用途。
      </p>
    </div>
  </section>
</Layout>
