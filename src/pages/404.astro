---
import Layout from '../layouts/Layout.astro';

const title = '页面未找到 - 三狮生物';
---

<Layout title={title}>
  <section class="container-site flex min-h-[50vh] flex-col items-center justify-center py-24 text-center">
    <div class="text-7xl font-bold text-brand-200">404</div>
    <h1 class="mt-4 text-2xl font-bold text-slate-900">页面未找到</h1>
    <p class="mt-2 text-slate-600">您访问的页面不存在或已被移动。</p>
    <a href="/" class="btn-primary mt-6">返回首页</a>
  </section>
</Layout>
