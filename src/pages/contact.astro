---
import PageBanner from '../components/PageBanner.astro';
import Layout from '../layouts/Layout.astro';

const title = '联系我们｜三狮生物';
const description =
  '联系河北三狮生物科技有限公司：总部电话0311-82970259，业务热线186-3213-6937，邮箱sanshibio@126.com，地址石家庄高新区太行南大街509号国械堂高端医疗器械产业园A-5栋702室。';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://sanshibio.com/' },
    { '@type': 'ListItem', position: 2, name: '联系我们' },
  ],
};
---

<Layout title={title} description={description} jsonLd={[breadcrumbLd]}>
  <PageBanner title="联系我们" description="设备、试剂、检测服务、技术培训，欢迎来电咨询合作。" breadcrumb="联系我们" />

  <section class="container-site py-16">
    <div class="grid gap-8 lg:grid-cols-2">
      <div class="card hover:-translate-y-0.5 hover:shadow-lg">
        <h2 class="text-xl font-semibold text-slate-900">联系方式</h2>
        <dl class="mt-6 space-y-5 text-sm">
          <div class="flex gap-4">
            <dt class="w-20 shrink-0 font-semibold text-slate-700">总部电话</dt>
            <dd><a href="tel:031182970259" class="text-brand-700 hover:underline">0311-82970259</a></dd>
          </div>
          <div class="flex gap-4">
            <dt class="w-20 shrink-0 font-semibold text-slate-700">业务热线</dt>
            <dd><a href="tel:18632136937" class="text-brand-700 hover:underline">186-3213-6937</a></dd>
          </div>
          <div class="flex gap-4">
            <dt class="w-20 shrink-0 font-semibold text-slate-700">邮箱</dt>
            <dd><a href="mailto:sanshibio@126.com" class="text-brand-700 hover:underline">sanshibio@126.com</a></dd>
          </div>
          <div class="flex gap-4">
            <dt class="w-20 shrink-0 font-semibold text-slate-700">网址</dt>
            <dd>www.sanshibio.com</dd>
          </div>
          <div class="flex gap-4">
            <dt class="w-20 shrink-0 font-semibold text-slate-700">地址</dt>
            <dd class="leading-relaxed">石家庄高新区太行南大街509号国械堂高端医疗器械产业园A-5栋702室</dd>
          </div>
        </dl>
      </div>

      <div class="card hover:-translate-y-0.5 hover:shadow-lg">
        <h2 class="text-xl font-semibold text-slate-900">咨询检测服务</h2>
        <p class="mt-3 text-sm text-slate-600">
          请告知您的需求（飞行能力基因检测 / 病毒检测 / 产品采购 / 技术培训），我们将尽快与您联系。
        </p>
        <div class="mt-6 rounded-xl bg-brand-50 p-5 text-sm text-brand-800">
          <p class="font-semibold">服务范围</p>
          <ul class="mt-2 space-y-1">
            <li>• 赛鸽飞行能力基因检测（8 项基因）</li>
            <li>• 赛鸽病毒病原体检测（10 种病原体）</li>
            <li>• 基因身份证 / AB 鸽 / 亲缘 / 性别鉴定</li>
            <li>• 检测设备与试剂采购、技术培训</li>
          </ul>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="tel:031182970259" class="btn-primary">立即致电</a>
          <a href="mailto:sanshibio@126.com" class="btn-outline">发送邮件</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
