---
interface Props {
  title: string;
  description?: string;
  breadcrumb: string;
}

const { title, description, breadcrumb } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-gradient-to-r from-brand-900 via-brand-800 to-deep-700 text-white">
  <div class="absolute inset-0 -z-10" style="background-image: radial-gradient(circle, rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 26px 26px;"></div>
  <div class="absolute -right-16 -top-16 -z-10 h-64 w-64 rounded-full bg-brand-400/15 blur-3xl"></div>
  <div class="container-site py-16 sm:py-20 lg:py-24">
    <nav class="mb-4 text-sm text-brand-100/80">
      <a href="/" class="transition hover:text-white">首页</a> <span class="mx-1 text-brand-200/60">/</span> {breadcrumb}
    </nav>
    <h1 class="max-w-3xl text-3xl font-bold leading-tight drop-shadow-sm sm:text-4xl">{title}</h1>
    {description && (
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-brand-50">{description}</p>
    )}
  </div>
</section>
