---
const navLinks = [
  { href: '/', label: '首页' },
  { href: '/about', label: '关于三狮' },
  { href: '/flight-ability', label: '飞行能力基因检测' },
  { href: '/virus-detection', label: '病毒检测' },
  { href: '/paternity', label: '亲子鉴定' },
  { href: '/products', label: '产品中心' },
  { href: '/services', label: '检测服务' },
  { href: '/contact', label: '联系我们' },
];

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 shadow-[0_1px_0_0_rgba(15,23,42,0.02)] backdrop-blur-md">
  <div class="container-site flex h-16 items-center justify-between gap-4 lg:h-20">
    <a href="/" class="flex shrink-0 items-center gap-2" aria-label="三狮生物首页">
      <img src="/images/logo.png" alt="三狮生物 logo" class="h-9 w-auto lg:h-10" />
    </a>
    <nav class="hidden items-center gap-6 text-sm font-medium text-slate-600 lg:flex">
      {navLinks.map((l) => (
        <a
          href={l.href}
          class:list={[
            'relative whitespace-nowrap transition-colors hover:text-brand-700',
            { 'font-semibold text-brand-700': pathname === l.href },
          ]}
        >
          {l.label}
          <span
            class:list={[
              'absolute -bottom-1 left-0 h-0.5 rounded-full bg-brand-600 transition-all duration-200',
              { 'w-full': pathname === l.href, 'w-0': pathname !== l.href },
            ]}
          ></span>
        </a>
      ))}
      <a href="/contact" class="btn-primary !px-4 !py-2 !text-xs">业务咨询</a>
    </nav>
    <button
      id="menu-btn"
      class="rounded-lg p-2 text-slate-600 transition hover:bg-slate-100 hover:text-brand-700 lg:hidden"
      aria-label="菜单"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white shadow-lg shadow-slate-900/5 lg:hidden">
    <nav class="container-site flex flex-col gap-1 py-3 text-sm font-medium text-slate-700">
      {navLinks.map((l) => (
        <a
          href={l.href}
          class:list={[
            'rounded-xl px-3 py-2.5 transition hover:bg-brand-50 hover:text-brand-700',
            { 'bg-brand-50 font-semibold text-brand-700': pathname === l.href },
          ]}
        >
          {l.label}
        </a>
      ))}
      <a href="/contact" class="btn-primary mt-2 w-full">业务咨询</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
  });
  document.querySelectorAll('#mobile-menu a').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
