---
import Layout from '../layouts/Layout.astro';
import PageBanner from './PageBanner.astro';

interface Props {
  title: string;
  description: string;
  bannerTitle: string;
  bannerDescription: string;
  breadcrumb: string;
  intro: string[];
  posts: any[];
  base: string;
  lang: 'zh' | 'en';
  serviceHref: string;
  serviceLabel: string;
}

const { title, description, bannerTitle, bannerDescription, breadcrumb, intro, posts, base, lang, serviceHref, serviceLabel } = Astro.props;
const readLabel = lang === 'zh' ? '阅读全文 →' : 'Read the guide →';
const allLabel = lang === 'zh' ? '返回知识库' : 'Back to the knowledge base';
const dateLocale = lang === 'zh' ? 'zh-CN' : 'en-GB';
---

<Layout title={title} description={description}>
  <PageBanner title={bannerTitle} description={bannerDescription} breadcrumb={breadcrumb} />

  <section class="container-site py-16">
    <div class="mx-auto max-w-3xl prose-sanshi">
      {intro.map((paragraph) => <p>{paragraph}</p>)}
      <p>
        <a href={base + '/blog/'} class="font-medium text-brand-700 hover:underline">{allLabel}</a>
        <span class="mx-2 text-slate-300">·</span>
        <a href={serviceHref} class="font-medium text-brand-700 hover:underline">{serviceLabel}</a>
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a href={`${base}/blog/${post.id}/`} class="card group hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-lg">
          <div class="flex items-center gap-2">
            <span class="rounded-full bg-brand-50 px-2 py-0.5 text-xs text-brand-700">{post.data.category}</span>
            <span class="text-xs text-slate-400">{post.data.pubDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric' })}</span>
          </div>
          <h2 class="mt-3 font-semibold text-slate-900 group-hover:text-brand-700">{post.data.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{post.data.description}</p>
          <span class="mt-4 inline-block text-sm font-medium text-brand-600">{readLabel}</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
